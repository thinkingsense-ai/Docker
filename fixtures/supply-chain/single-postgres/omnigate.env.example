# Supply chain fixture, Tier B: single-Postgres variant. Edit HOST/DB/USER/PASS below to match
# your real Postgres instance, then: psql ... -f seed.sql (run once), then source this file.
#
# Each "backend" is the SAME physical Postgres server/database -- only the ?currentSchema=
# differs -- so OmniGate still genuinely federates across 4 backends (real RouterStage/
# FederationStage code path), it just needs zero extra infrastructure beyond one Postgres.

HOST=127.0.0.1
PORT=5432
DB=postgres
USER=postgres
PASS=omnigate

export OMNIGATE_BACKENDS="suppliers=jdbc:postgresql://${HOST}:${PORT}/${DB}?currentSchema=suppliers|${USER}|${PASS};inventory=jdbc:postgresql://${HOST}:${PORT}/${DB}?currentSchema=inventory|${USER}|${PASS};procurement=jdbc:postgresql://${HOST}:${PORT}/${DB}?currentSchema=procurement|${USER}|${PASS};logistics=jdbc:postgresql://${HOST}:${PORT}/${DB}?currentSchema=logistics|${USER}|${PASS}"

# Router labels equal the real native schema name here, same as the backend name (they're
# identical in this single-Postgres layout) -- the simplest possible case.
export OMNIGATE_ROUTER_SCHEMA_RULES="suppliers:suppliers,inventory:inventory,procurement:procurement,logistics:logistics"
