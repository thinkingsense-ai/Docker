# Real OmniGate config for the supply-chain fixture -- source this (or copy the values) after
# running ./seed.sh. See README.md for the story and schema.

MSSQL_URL='jdbc:sqlserver://127.0.0.1:11433%3BdatabaseName=logistics%3Bencrypt=false%3BtrustServerCertificate=true'
MYSQL_URL='jdbc:mysql://127.0.0.1:13306/inventory?allowPublicKeyRetrieval=true&useSSL=false'

export OMNIGATE_BACKENDS="suppliers=jdbc:postgresql://127.0.0.1:15432/suppliers|postgres|omnigate;inventory=${MYSQL_URL}|root|omnigate;procurement=jdbc:oracle:thin:@127.0.0.1:11521/freepdb1|procurement|omnigate;logistics=${MSSQL_URL}|sa|OmniGate!Strong1"

# Router rules map each backend's REAL native schema name (what NL2SQL's own generated SQL uses,
# since it's driven from the introspected catalog) to the OmniGate backend name.
export OMNIGATE_ROUTER_SCHEMA_RULES="public:suppliers,inventory:inventory,procurement:procurement,dbo:logistics"

# Optional, for the OMNIGATE_QUERY_ENGINE=trino path (docs/deployment/trino-cluster.md) -- generate
# real Trino catalogs for these four backends with:
#   OMNIGATE_BACKENDS="$OMNIGATE_BACKENDS" java -cp target/omnigate.jar \
#     com.omnigate.exec.TrinoCatalogGeneratorCli ./trino-catalog
