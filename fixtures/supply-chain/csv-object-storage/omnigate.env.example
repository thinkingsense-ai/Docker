# Supply chain fixture, Tier C: mixed connectors -- suppliers + warehouse_inventory as real CSV
# files (object storage in production, a local directory here for the demo), procurement +
# logistics in a real Postgres database. Demonstrates a real federated join across a database
# AND a non-database (object-storage-shaped) source in one query.
#
# 1. Run seed-postgres.sql against your Postgres instance (creates procurement/logistics).
# 2. Edit CSV_DIR below to the absolute path of this directory (where suppliers.csv/
#    warehouse_inventory.csv already live).
# 3. source this file, then boot OmniGate.
#
# To use REAL object storage instead of a local directory: change "provider":"local","baseDir":
# "<path>" to "provider":"s3","bucket":"<your-bucket>" (with AWS credentials configured the usual
# way) or "provider":"azureblob","accountName":"...". Nothing else in this config changes -- the
# "tables" map and every downstream federation/NL2SQL/Federation-Plans behavior is identical
# regardless of which object-storage provider backs it. See S3SchemaFactory's own javadoc.

CSV_DIR=/absolute/path/to/fixtures/supply-chain/csv-object-storage
HOST=127.0.0.1
PORT=5432
DB=postgres
USER=postgres
PASS=omnigate

SUPPLIERS_MODEL='jdbc:calcite:model=inline:{"version":"1.0","schemas":[{"name":"suppliers","type":"custom","factory":"com.omnigate.calcite.s3.S3SchemaFactory","operand":{"provider":"local","baseDir":"'"${CSV_DIR}"'","tables":{"suppliers":{"key":"suppliers.csv","format":"csv"}}}}]}'
INVENTORY_MODEL='jdbc:calcite:model=inline:{"version":"1.0","schemas":[{"name":"inventory","type":"custom","factory":"com.omnigate.calcite.s3.S3SchemaFactory","operand":{"provider":"local","baseDir":"'"${CSV_DIR}"'","tables":{"warehouse_inventory":{"key":"warehouse_inventory.csv","format":"csv"}}}}]}'

export OMNIGATE_BACKENDS="suppliers=${SUPPLIERS_MODEL}|;inventory=${INVENTORY_MODEL}|;procurement=jdbc:postgresql://${HOST}:${PORT}/${DB}?currentSchema=procurement|${USER}|${PASS};logistics=jdbc:postgresql://${HOST}:${PORT}/${DB}?currentSchema=logistics|${USER}|${PASS}"

export OMNIGATE_ROUTER_SCHEMA_RULES="suppliers:suppliers,inventory:inventory,procurement:procurement,logistics:logistics"

# Real, honest limitation (see fixtures/supply-chain/README.md and docs/deployment/trino-cluster.md):
# CSV/S3-backed (GENERIC_REST) backends are only reachable through Calcite's own ConnectorProvider
# mounting -- they have no Trino catalog mapping today, so this variant only works with the default
# Calcite engine (leave OMNIGATE_QUERY_ENGINE unset / do not set OMNIGATE_TRINO_JDBC_URL).
