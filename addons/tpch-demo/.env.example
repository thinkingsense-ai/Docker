# TPC-H demo add-on -- BUNDLED mode defaults. Copy to .env and run:
#   docker compose -f docker-compose.tpch.yml --profile tpch-bundled up
#
# Every value below already has a working default baked into docker-compose.tpch.yml, matching
# this project's own TPC-H benchmark setup (bucket "tpch", MinIO's default demo credentials). You
# only need this file if you want to change the scale factor or the demo credentials.

# ~1GB of real TPC-H data (DuckDB's own tpch extension, scale factor 1 == dbgen's own "1GB" sizing).
# Raise this (e.g. 10) for a bigger demo dataset -- the loader regenerates automatically the first
# time it sees a different scale factor's worth of missing data.
TPCH_SCALE_FACTOR=1

# Set to "true" to force a full regenerate even if data already looks loaded (e.g. after changing
# TPCH_SCALE_FACTOR, since the idempotency check alone won't notice a smaller-than-expected reload).
TPCH_FORCE_RELOAD=false

# Bundled Postgres credentials (the tpch-postgres container created by this compose file) --
# change these if you're running this somewhere more exposed than your own machine.
TPCH_DIM_USER=postgres
TPCH_DIM_PASSWORD=omnigate

# Bundled MinIO credentials and bucket name.
TPCH_LINEITEM_BUCKET=tpch
TPCH_LINEITEM_ACCESS_KEY_ID=minioadmin
TPCH_LINEITEM_SECRET_ACCESS_KEY=minioadmin
