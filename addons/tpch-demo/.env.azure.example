# TPC-H demo add-on -- BRING-YOUR-OWN mode, LINEITEM in Azure Blob Storage. Azure Blob is the one
# target this add-on does NOT reach via the shared S3-compatible code path -- a real, disclosed
# asymmetry (see S3SchemaFactory's own "s3" vs "azureblob" providers, and
# generate_and_load.py's upload_lineitem_azure). Copy to .env, fill in the placeholders, and run:
#   docker compose -f docker-compose.tpch.yml --profile tpch-byo up
#
# See .env.aws.example's own header comment for the TPCH_DIM_JDBC_URL constraint (no query string).

TPCH_SCALE_FACTOR=1
TPCH_FORCE_RELOAD=false

TPCH_DIM_JDBC_URL=jdbc:postgresql://your-postgres-host:5432/your_database
TPCH_DIM_USER=your_db_user
TPCH_DIM_PASSWORD=your_db_password

TPCH_LINEITEM_PROVIDER=azureblob
# Used as the Azure Blob CONTAINER name (not an S3 bucket) when the provider above is "azureblob".
TPCH_LINEITEM_BUCKET=your-container-name
TPCH_LINEITEM_AZURE_ACCOUNT_NAME=your-storage-account-name
# Find this under Azure Portal -> (your storage account) -> Access keys.
TPCH_LINEITEM_AZURE_ACCOUNT_KEY=your-storage-account-key
