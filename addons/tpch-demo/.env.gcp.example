# TPC-H demo add-on -- BRING-YOUR-OWN mode, LINEITEM in Google Cloud Storage. GCS speaks the
# S3-compatible "interoperability API", so this uses the exact same provider: "s3" code path as
# AWS/MinIO/OCI -- only the endpoint and path-style setting differ. Copy to .env, fill in the
# placeholders, and run:
#   docker compose -f docker-compose.tpch.yml --profile tpch-byo up
#
# See .env.aws.example's own header comment for the TPCH_DIM_JDBC_URL constraint (no query string).

TPCH_SCALE_FACTOR=1
TPCH_FORCE_RELOAD=false

TPCH_DIM_JDBC_URL=jdbc:postgresql://your-postgres-host:5432/your_database
TPCH_DIM_USER=your_db_user
TPCH_DIM_PASSWORD=your_db_password

TPCH_LINEITEM_PROVIDER=s3
TPCH_LINEITEM_BUCKET=your-bucket-name
TPCH_LINEITEM_ENDPOINT=https://storage.googleapis.com
TPCH_LINEITEM_REGION=auto
TPCH_LINEITEM_PATH_STYLE=true
# Create these under Google Cloud Console -> Cloud Storage -> Settings -> Interoperability ->
# "Create a key" -- NOT your regular GCP service-account JSON key, which uses a different
# (non-S3-compatible) auth scheme this loader doesn't speak.
TPCH_LINEITEM_ACCESS_KEY_ID=your-hmac-access-key
TPCH_LINEITEM_SECRET_ACCESS_KEY=your-hmac-secret
