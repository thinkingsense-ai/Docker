# TPC-H demo add-on -- BRING-YOUR-OWN mode, LINEITEM in Oracle Cloud Infrastructure Object
# Storage. OCI Object Storage speaks the S3-compatible API, so this uses the exact same
# provider: "s3" code path as AWS/MinIO/GCS -- only the endpoint and path-style setting differ.
# Copy to .env, fill in the placeholders, and run:
#   docker compose -f docker-compose.tpch.yml --profile tpch-byo up
#
# See .env.aws.example's own header comment for the TPCH_DIM_JDBC_URL constraint (no query string).

TPCH_SCALE_FACTOR=1
TPCH_FORCE_RELOAD=false

TPCH_DIM_JDBC_URL=jdbc:postgresql://your-postgres-host:5432/your_database
TPCH_DIM_USER=your_db_user
TPCH_DIM_PASSWORD=your_db_password

TPCH_LINEITEM_PROVIDER=s3
TPCH_LINEITEM_BUCKET=your-bucket-name
# OCI's S3-compatible endpoint is per-namespace/region:
#   https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# Find your namespace under Object Storage -> Buckets -> (your bucket) -> Namespace in the OCI console.
TPCH_LINEITEM_ENDPOINT=https://your-namespace.compat.objectstorage.your-region.oraclecloud.com
TPCH_LINEITEM_REGION=your-region
# OCI's S3-compatible API requires path-style addressing.
TPCH_LINEITEM_PATH_STYLE=true
# Generate these under OCI Console -> (your user) -> Customer Secret Keys -- NOT your regular OCI
# API signing key, which uses a different (non-S3-compatible) auth scheme this loader doesn't speak.
TPCH_LINEITEM_ACCESS_KEY_ID=your-customer-secret-key-id
TPCH_LINEITEM_SECRET_ACCESS_KEY=your-customer-secret-key
