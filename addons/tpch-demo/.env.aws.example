# TPC-H demo add-on -- BRING-YOUR-OWN mode, LINEITEM in real AWS S3. Copy to .env, fill in the
# placeholders, and run:
#   docker compose -f docker-compose.tpch.yml --profile tpch-byo up
#
# Real, disclosed constraint for this version: TPCH_DIM_JDBC_URL must be a bare
# jdbc:postgresql://host:port/database URL with NO query string of its own -- the compose file
# appends "?currentSchema=public" to it directly. If your Postgres needs extra JDBC params
# (sslmode, etc.), the current template doesn't support combining them; flagged as real,
# scoped-out follow-on work, not silently broken.

TPCH_SCALE_FACTOR=1
TPCH_FORCE_RELOAD=false

# Your own Postgres instance for the seven dimension tables (customer, orders, part, partsupp,
# supplier, nation, region). Must already exist and be reachable from this compose stack.
TPCH_DIM_JDBC_URL=jdbc:postgresql://your-postgres-host:5432/your_database
TPCH_DIM_USER=your_db_user
TPCH_DIM_PASSWORD=your_db_password

# Real AWS S3 -- no endpoint/path-style override needed, this is the one case where leaving
# TPCH_LINEITEM_ENDPOINT blank is correct (S3SchemaFactory falls back to the AWS SDK's own
# default endpoint resolution + virtual-hosted-style addressing).
TPCH_LINEITEM_PROVIDER=s3
TPCH_LINEITEM_BUCKET=your-bucket-name
TPCH_LINEITEM_ENDPOINT=
TPCH_LINEITEM_REGION=us-east-1
TPCH_LINEITEM_PATH_STYLE=false
# Leave blank to use the AWS SDK's own default credential chain (IAM role, ~/.aws/credentials
# mounted into the container, etc.) instead of a literal access key pair -- recommended over
# putting a real AWS key in this file. If you do set a literal pair, treat this file as a secret.
TPCH_LINEITEM_ACCESS_KEY_ID=
TPCH_LINEITEM_SECRET_ACCESS_KEY=
